# ==============================================================================
# IoTShield AI - Git Ignore Configuration
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Archives and Packages (strictly excluded)
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
IoTShield_AI_Project.zip

# Video and Screen Recording Formats (strictly excluded)
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.flv
*.wmv
*.m4v

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Testing, Coverage and Cache
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Streamlit local runtime state
.streamlit/secrets.toml
.chrome_tmp*

# Development tooling and local agent state
.agents/

# Dynamic Simulation Artifacts (retain initial baseline .demo dummy files and .gitkeep)
demo_sandbox/*/*.locked_demo
demo_sandbox/*/SIMULATED_RANSOM_NOTE.txt

# Operating System Files
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# IDE and Editor Workspace Configurations
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
